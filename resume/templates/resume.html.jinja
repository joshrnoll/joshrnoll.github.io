<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon/favicon.ico" sizes="any">
  <link rel="preload" href="./fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="./styles.css">
  <link rel="stylesheet" href="./print.css" media="print">
  <script>
    // Play the Neovim intro only when JS runs and the visitor hasn't asked for reduced motion.
    // Without JS (or with reduced motion) the rendered resume shows immediately.
    try {
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('nvim-intro');
      }
    } catch (e) {}
  </script>
  <script type="module" src="scripts.js"></script>
  <title>Josh Noll's Resume</title>
</head>
<body>
  <!-- Navbar and the page status bar are the site layout's. This document is only the resume body. -->
  <main class="container resume">
    <!-- Neovim buffer intro (mirrors the joshrnoll.com landing page). Decorative only:
         the full resume below is always in the DOM for screen readers and crawlers. -->
    <div class="nvim-wrap" id="nvim-wrap" aria-hidden="true">
      <div class="nvim-frame" id="nvim-frame">
        <div class="nvim-content" id="nvim-content"></div>
      </div>
      <button type="button" class="nvim-skip" id="nvim-skip" tabindex="-1">skip intro &rarr;</button>
    </div>

    <!-- Markdown source typed into the buffer, generated from resume.yaml -->
    <template id="resume-src">
      <div data-k="dim"># resume.md</div>
      <div></div>
      <div data-k="h1" data-type="ciw">## {{ cv.name }}</div>
      <div></div>
      <div data-k="links" data-type="i">{% for social in cv.social_networks %}[{{ social.network }}]  {% endfor %}[Website]  [PDF]</div>
      <div></div>
      <div data-k="h2">## Summary</div>
      {%- for item in cv.sections.summary %}
      <div>{{ item }}</div>
      {%- endfor %}
      <div></div>
      <div data-k="h2">## Technologies</div>
      {%- for skill in cv.sections.skills %}
      <div>{{ skill }}</div>
      {%- endfor %}
      <div></div>
      <div data-k="h2">## Certifications</div>
      {%- for cert in cv.sections.certifications %}
      <div>{{ cert }}</div>
      {%- endfor %}
      <div></div>
      <div data-k="h2">## Experience</div>
      {%- for exp in cv.sections.experience %}
      <div></div>
      <div data-k="h3">### {{ exp.position }}, {{ exp.company }}</div>
      <div data-k="dim">_{{ exp.start_date }} - {{ exp.end_date }}_</div>
      {%- for highlight in exp.highlights %}
      <div data-k="li">- {{ highlight }}</div>
      {%- endfor %}
      {%- endfor %}
      <div></div>
      <div data-k="h2">## Volunteering</div>
      {%- for vol in cv.sections.volunteering %}
      <div></div>
      <div data-k="h3">### {{ vol.position }}, {{ vol.company }}</div>
      <div data-k="dim">_{{ vol.start_date }} - {{ vol.end_date }}_</div>
      {%- for highlight in vol.highlights %}
      <div data-k="li">- {{ highlight }}</div>
      {%- endfor %}
      {%- endfor %}
      <div></div>
      <div data-k="h2">## Technical Projects</div>
      {%- for project in cv.sections.projects %}
      <div data-k="li">- **{{ project.name }}** | {{ project.summary }}</div>
      {%- endfor %}
      <div></div>
      <div data-k="h2">## Education</div>
      {%- for edu in cv.sections.education %}
      <div data-k="h3">### {{ edu.label }}</div>
      <div>{{ edu.details }}</div>
      {%- endfor %}
    </template>

    <div class="md-preview" id="resume-preview">
    <header>
      <section id="header">
        <h1>{{ cv.name }}</h1>
        <div class="button-group">
          <a class="cta" href="{{ cv.website }}">My Website</a>
          {% for social in cv.social_networks %}
          {% if social.network == 'LinkedIn' %}
          <a class="cta" href="https://linkedin.com/in/{{ social.username }}">My LinkedIn</a>
          {% elif social.network == 'GitHub' %}
          <a class="cta" href="https://github.com/{{ social.username }}">My GitHub</a>
          {% endif %}
          {% endfor %}
        </div>
        <a id="pdfview" class="cta cta--pdf" href="resume.pdf">View this resume as a PDF</a>
      </section>
    </header>

    <section id="summary">
      <h2>Summary</h2>
      <p>
        {%- for item in cv.sections.summary -%}
          {{ item }}
        {%- endfor-%}
      </p>
    </section>

    <section id="technologies">
      <h2>Technologies</h2>
      <div class="badges">
        {%- for skill in cv.sections.skills -%}
        {%- for tech in skill.split('|') %}
        <span class="stack-badge">{{ tech | trim }}</span>
        {%- endfor -%}
        {%- endfor %}
      </div>
    </section>

    <section id="certifications">
      <h2>Certifications</h2>
      <div class="badges">
        {%- for cert in cv.sections.certifications -%}
        {%- for item in cert.split(' | ') %}
        <span class="cert-badge">{{ item | trim | md_link | safe }}</span>
        {%- endfor -%}
        {%- endfor %}
      </div>
    </section>

    <section id="experience">
      <h2>Experience</h2>
      {% for exp in cv.sections.experience %}
      <div class="entry">
        <h3>{{ exp.position }}, {{ exp.company }}</h3>
        <h4>{{ exp.start_date }} - {{ exp.end_date }}</h4>
        <ul>
          {% for highlight in exp.highlights %}
          <li class="accomplishments">{{ highlight }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </section>

    <section id="volunteering">
      <h2>Volunteering</h2>
      {% for vol in cv.sections.volunteering %}
      <div class="entry">
        <h3>{{ vol.position }}, {{ vol.company }}</h3>
        <h4>{{ vol.start_date }} - {{ vol.end_date }}</h4>
        <ul>
          {% for highlight in vol.highlights %}
          <li class="accomplishments">{{ highlight }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </section>

    <section id="projects">
      <h2>Technical Projects</h2>
      <ul>
        {% for project in cv.sections.projects %}
        <li>
          <strong>{{ project.name | md_link | safe }}</strong> <span>| {{ project.summary }}</span>
        </li>
        {% endfor %}
      </ul>
    </section>

    <section id="education">
      <h2>Education</h2>
      <ul>
        {% for edu in cv.sections.education %}
        <li>
          <h3>{{ edu.label }}</h3>
          <h4>{{ edu.details }}</h4>
        </li>
        {% endfor %}
      </ul>
    </section>
    </div>
  </main>
</body>
</html>
