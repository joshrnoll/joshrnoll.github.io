---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BoardScrap from '../../components/BoardScrap.astro';
import { getEntry } from 'astro:content';

const { page, yard } = (await getEntry('scraps', 'scraps'))!.data;
---
<BaseLayout title={page.title} description={page.description}>
  <div class="container yard">
    <header class="yard-header">
      <h1>{page.title}<span>.</span></h1>
      <p>{page.subtitle}</p>
      {page.draftNote && <p class="draft-note">{page.draftNote}</p>}
    </header>
    <ul class="yard-scraps">
      {yard.map((scrap, index) => (
        <li><BoardScrap scrap={scrap} delay={100 + index * 135} /></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
.yard { padding-block: clamp(2.5rem, 6vw, 5rem) 5rem; }
.yard-header h1 {
  font-size: clamp(3rem, 7.5vw, 6.75rem);
  letter-spacing: -.085em;
  line-height: 1.02;
}
.yard-header h1 span { color: var(--green); }
.yard-header p { margin-top: .75rem; }
.draft-note { color: var(--red); font: 700 1.25rem var(--font-marker); }
.yard-scraps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;
  gap: clamp(2rem, 4vw, 3.5rem);
  padding: 2.5rem clamp(.35rem, 4vw, 3rem);
  margin-top: 1.35rem;
  border-top: 1px solid var(--line);
  list-style: none;
}
.yard-scraps li:nth-child(4n + 1) { --tilt: -4deg; }
.yard-scraps li:nth-child(4n + 2) { --tilt: 3deg; }
.yard-scraps li:nth-child(4n + 4) { --tilt: 2deg; }
.yard-scraps li :global(.scrap) { min-height: 10rem; --tilt: inherit; }
@media (max-width: 720px) {
  .yard-scraps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 480px) {
  .yard-scraps { grid-template-columns: minmax(0, 1fr); gap: 1.15rem; padding-inline: .8rem; }
  .yard-scraps li :global(.scrap) { min-height: 6.5rem; --tilt: 0deg; }
}
</style>
