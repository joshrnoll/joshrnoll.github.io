---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BoardScrap from '../../components/BoardScrap.astro';
import { scrapyardScraps } from '../../data/scraps';
---
<BaseLayout title="Scrapyard" description="A place for half-baked ideas and loose ends.">
  <div class="container yard">
    <header class="yard-header">
      <h1>Scrapyard<span>.</span></h1>
      <p>Half-baked ideas and loose ends.</p>
    </header>
    <ul class="yard-scraps">
      {scrapyardScraps.map((scrap, index) => (
        <li><BoardScrap scrap={scrap} delay={100 + index * 135} /></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
.yard { padding-block: clamp(2.5rem, 6vw, 5rem) 5rem; }
.yard-header h1 {
  font-size: clamp(3rem, 7.5vw, 6.75rem);
  letter-spacing: -.085em;
  line-height: 1.02;
}
.yard-header h1 span { color: var(--green); }
.yard-header p { margin-top: .75rem; }
/* Two columns so the four scraps sit as a 2x2 board instead of 3 + 1. */
.yard-scraps {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: center;
  gap: clamp(2rem, 4vw, 3.5rem);
  /* Keep the divider full width but cap the board at about 52rem. */
  padding: 2.5rem max(clamp(.35rem, 4vw, 3rem), calc((100% - 52rem) / 2));
  margin-top: 1.35rem;
  border-top: 1px solid var(--line);
  list-style: none;
}
.yard-scraps li:nth-child(4n + 1) { --tilt: -4deg; }
.yard-scraps li:nth-child(4n + 2) { --tilt: 3deg; }
.yard-scraps li:nth-child(4n + 4) { --tilt: 2deg; }
.yard-scraps li :global(.scrap) { min-height: 10rem; --tilt: inherit; }
@media (max-width: 480px) {
  .yard-scraps { grid-template-columns: minmax(0, 1fr); gap: 1.15rem; padding-inline: .8rem; }
  .yard-scraps li :global(.scrap) { min-height: 6.5rem; --tilt: 0deg; }
}
</style>
