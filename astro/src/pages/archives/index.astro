---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/prose.css';
---
<BaseLayout title="Archives" description="Archives">
  <div class="container post-layout">
    <article class="post-content">
      <header class="post-header"><h1 class="post-title">Archives</h1></header>
      <div class="prose">
        <p>Previous versions and projects from the site.</p>
        <p><a href="/archives/homelab/">Homelab tour (hardware and architecture)</a></p>
        <p><a href="/archives/homelab-diagram/">Homelab diagram (previous version)</a></p>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
.post-layout { display: grid; grid-template-columns: 1fr; gap: 2rem; padding-top: 2rem; padding-bottom: 4rem; }
.post-header { margin-bottom: 2rem; }
.post-title { color: var(--fg); font-size: 1.75rem; line-height: 1.25; margin-bottom: 0.75rem; }
</style>
