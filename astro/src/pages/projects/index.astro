---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const { projects } = (await getEntry('projects', 'projects'))!.data;
---
<BaseLayout title="Projects">
  <div class="container projects">
    <h1 class="page-title">Projects</h1>
    <ul class="project-list">
      {projects.map(project => (
        <li class="project-card" id={project.id}>
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <ul class="project-stack" aria-label="Technologies">
            {project.stack.map(tech => <li>{tech}</li>)}
          </ul>
          <div class="project-links">
            {project.links.map(link => (
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
.projects { padding-block: clamp(2.4rem, 6vw, 5rem) 5rem; }
.projects h1 { margin-bottom: clamp(1.8rem, 4vw, 3rem); }

.project-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
  list-style: none;
}

.project-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.65rem;
  padding: clamp(1.2rem, 2.5vw, 1.85rem);
  border: 1px solid var(--line);
  border-radius: 0.7rem;
  background: var(--surface);
  box-shadow: 0 2px 5px #202a2809;
  overflow-wrap: break-word;
}

.project-card:target {
  border-color: var(--blue);
  box-shadow: 0 0 0 2px var(--blue);
}

.project-card h2 { font-size: 1.35rem; line-height: 1.2; letter-spacing: -0.035em; }
.project-card p { color: var(--comment); font-size: 0.92rem; }

.project-stack, .project-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}

.project-stack { list-style: none; }

.project-stack li {
  padding: 0.15rem 0.6rem;
  border-radius: 100px;
  background: var(--bg-dark);
  color: var(--comment);
  font-size: 0.76rem;
}

.project-links { gap: 1rem; margin-top: auto; padding-top: 0.45rem; }
.project-links a { font-size: 0.85rem; font-weight: 650; }

@media (max-width: 690px) {
  .project-list { grid-template-columns: minmax(0, 1fr); }
}
</style>
