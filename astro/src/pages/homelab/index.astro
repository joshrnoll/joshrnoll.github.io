---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderMarkdown } from '../../lib/markdown';
import '../../styles/prose.css';

const page = (await getEntry('homelab', 'homelab'))!.data;
const slug = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const sections = await Promise.all(page.sections.map(async section => ({
  ...section,
  id: section.id ?? slug(section.heading),
  html: await renderMarkdown(section.body),
})));
---
<BaseLayout title={page.title} description={page.description}>
  <div class="container post-layout">
    <article class="post-content">
      <header class="post-header">
        <h1 class="page-title">{page.title}</h1>
      </header>
      <div class="prose">
        <h2 id="diagram">{page.diagram.heading}</h2>
        <iframe src="/homelab-diagram/viewer.html" title={page.diagram.frameTitle} loading="lazy"></iframe>
        <p><a href="/homelab-diagram/viewer.html">{page.diagram.fullScreenLink}</a> · <a href="/homelab-diagram/homelab-diagram.svg">{page.diagram.rawSvgLink}</a></p>
        {sections.map(({ level: Heading, id, heading, html }) => (
          <>
            <Heading id={id}>{heading}</Heading>
            <Fragment set:html={html} />
          </>
        ))}
      </div>
    </article>
  </div>
</BaseLayout>

<style>
.post-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 2rem;
  padding-block: clamp(2.4rem, 6vw, 5rem) 5rem;
}
.post-header { margin-bottom: 2rem; }
iframe {
  display: block;
  width: 100%;
  min-height: 420px;
  height: 70vh;
  border: 2px solid var(--line);
  border-radius: .9rem .6rem 1rem .5rem / .5rem .9rem .6rem 1rem;
  box-shadow: 0 .35rem 1.1rem light-dark(#1a322512, #0003);
}

/* Section bodies come from Markdown, which has no scoped-style attribute. */
.prose :global(:is(p, ol)) { max-width: 72ch; }
</style>
