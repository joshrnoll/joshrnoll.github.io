---
import BaseLayout from '../layouts/BaseLayout.astro';
import resumeHtml from '../../../resume/src/index.html?raw';

const resumeBody = resumeHtml.match(/<main\b[^>]*>([\s\S]*)<\/main>/i)?.[1];
if (!resumeBody) {
  throw new Error('The generated resume is missing its main content. Run resume/make.py.');
}
---
<BaseLayout title="Resume" description="Josh Noll's resume.">
  <link slot="head" rel="stylesheet" href="/resume/styles.css" />
  <link slot="head" rel="preload" href="/fonts/josh-noll-hand/josh-noll-hand.woff2" as="font" type="font/woff2" crossorigin />
  <noscript><style is:inline>.resume[data-intro] :is(.resume-title, .resume-actions) { visibility: visible !important; }</style></noscript>
  <div class="container resume" data-intro="waiting" set:html={resumeBody} />
</BaseLayout>

<script>
  // Section headings write themselves in as they scroll into view, like the masthead.
  function drawResumeHeadings() {
    const resume = document.querySelector<HTMLElement>('main .resume');
    if (!resume || !matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
    const headings = resume.querySelectorAll<HTMLElement>(':scope > section > h2');
    // Headings are only hidden once the observer reports them off screen,
    // so they stay visible if the observer never runs.
    const observer = new IntersectionObserver(entries => {
      for (const { target, isIntersecting } of entries) {
        target.classList.toggle('is-pending', !isIntersecting);
        if (!isIntersecting) continue;
        target.classList.add('is-drawn');
        observer.unobserve(target);
      }
    }, { rootMargin: '0px 0px -12% 0px' });
    resume.classList.add('resume--drawing');
    headings.forEach(heading => observer.observe(heading));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  // Start the masthead intro only after the handwriting font loads, or after
  // 3 seconds so a slow font never leaves the masthead blank.
  function startResumeIntro() {
    const resume = document.querySelector<HTMLElement>('main .resume[data-intro]');
    const name = resume?.querySelector<HTMLElement>('.resume-title h1');
    if (!resume || !name) return;
    const start = () => { if (resume.isConnected) resume.dataset.intro = 'ready'; };
    if (!matchMedia('(prefers-reduced-motion: no-preference)').matches) return start();
    // Load only the first family, so the Kalam fallback isn't fetched too.
    const { fontWeight, fontFamily } = getComputedStyle(name);
    const [handwriting] = fontFamily.split(',');
    const text = `${resume.querySelector('.resume-draft-text')?.textContent ?? ''}${name.textContent ?? ''}`;
    const timeout = new Promise(resolve => setTimeout(resolve, 3000));
    Promise.race([document.fonts.load(`${fontWeight} 1em ${handwriting}`, text), timeout]).then(start, start);
  }

  document.addEventListener('astro:page-load', startResumeIntro);
  document.addEventListener('astro:page-load', drawResumeHeadings);
</script>
