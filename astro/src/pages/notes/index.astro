---
// astro/src/pages/notes/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import SearchBar from '../../components/SearchBar.astro';
import { getAllTags } from '../../utils/tags';

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const sorted = allNotes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = getAllTags(allNotes.map(p => ({ tags: p.data.tags })));

const noteData = sorted.map(p => ({
  title: p.data.title,
  slug: `notes/${p.id.replace(/\.mdx?$/, '')}`,
  date: p.data.date,
  description: p.data.description,
  tags: p.data.tags,
}));
---
<BaseLayout title="Notes">
  <div class="container archive-list">
    <h1 class="page-title">Notes</h1>
    <p class="page-subtitle">{sorted.length} notes</p>

    <SearchBar src="/notes-search-index.json" basePath="notes" placeholder="Search notes" />
    <p class="search-hint">Press <kbd>/</kbd> to search, <kbd>Esc</kbd> to clear</p>

    <TagFilter tags={allTags} />

    <div class="post-list" id="post-list">
      {noteData.map(p => (
        <BlogCard
          title={p.title}
          slug={p.slug}
          date={p.date}
          description={p.description}
          tags={p.tags}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
.archive-list {
  max-width: 64rem;
  padding-block: clamp(2.4rem, 6vw, 5rem) 5rem;
}

.page-subtitle { color: var(--comment); font-size: 0.875rem; margin: 0.65rem 0 1.8rem; }
.post-list { display: flex; flex-direction: column; gap: 0.85rem; }
.post-list[hidden] { display: none; }
.search-hint { color: var(--comment); font-size: 0.75rem; margin-bottom: 1.25rem; }

kbd {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 4px;
  padding: 0.08em 0.35em;
  font-size: 0.75rem;
}
</style>
