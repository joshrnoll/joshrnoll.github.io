---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found">
  <div class="container missing">
    <h1 class="page-title">Page not found</h1>
    <svg viewBox="0 0 210 22" aria-hidden="true">
      <path d="M3 13Q56 1 118 8t88 2M29 16Q93 9 171 14" />
    </svg>
    <p><a href="/">Return home</a> or <a href="/blog/">browse the blog</a>.</p>
  </div>
</BaseLayout>

<style>
.missing { padding-block: clamp(3rem, 8vw, 7rem); }
.missing svg {
  width: min(13rem, 60%);
  fill: none;
  stroke: var(--red);
  stroke-width: 2.7;
  stroke-linecap: round;
}
.missing p { margin-top: .8rem; }
.missing a { text-decoration: underline; text-underline-offset: .2em; }
</style>
