---
import BaseLayout from './BaseLayout.astro';
import TagBadge from '../components/TagBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import '../styles/prose.css';

interface Props {
  post: CollectionEntry<'blog'> | CollectionEntry<'notes'>;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, date, tags, description } = post.data;
const hasToc = post.collection === 'blog' && post.data.toc && headings.some(heading => heading.depth === 2 || heading.depth === 3);
const slug = (post.collection === 'blog' ? post.data.slug : undefined) ?? post.id.replace(/\.mdx?$/, '');
const ogImage = `/og/${post.collection}/${slug}.png`;
const listing = post.collection === 'blog' ? { href: '/blog/', label: 'All posts' } : { href: '/notes/', label: 'All notes' };

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---
<BaseLayout title={title} description={description} ogImage={ogImage} ogType="article">
  <div class:list={['post-layout', 'container', { 'has-toc': hasToc }]}>
    {hasToc && (
      <aside class="post-toc">
        <TableOfContents headings={headings} />
      </aside>
    )}
    <article class="post-content">
      <header class="post-header">
        <a class="back-link" href={listing.href}><span aria-hidden="true">←</span> {listing.label}</a>
        <h1 class="page-title post-title">{title}</h1>
        <svg class="title-underline" viewBox="0 0 153 17" aria-hidden="true" fill="none">
          <path pathLength="1" d="M3 12 C20 8 25 7.4 39 7.6 C59 7.9 72 3.4 101 4.6 Q127 4.7 149 3" />
          <path pathLength="1" d="M16 14 Q36 11 61 11.5 C74 11.8 106 7.7 130 8.3" />
        </svg>
        <div class="post-meta">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {tags.length > 0 && (
            <div class="post-tags">
              {tags.map(tag => <TagBadge tag={tag} />)}
            </div>
          )}
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
.post-layout {
  display: grid;
  grid-template-columns: minmax(0, 48rem);
  justify-content: center;
  column-gap: clamp(2rem, 5vw, 5rem);
  padding-block: clamp(2.4rem, 6vw, 5rem) 5rem;
}

.post-toc { display: none; }
.post-content { min-width: 0; }

@media (min-width: 1080px) {
  .post-layout.has-toc {
    grid-template-columns: minmax(0, 12rem) minmax(0, 48rem);
  }

  .post-toc { display: block; }
}

.post-header {
  padding-bottom: 1.5rem;
  margin-bottom: 1.8rem;
  border-bottom: 1px solid var(--line);
}

.back-link {
  display: inline-flex;
  gap: 0.5em;
  align-items: center;
  margin-bottom: 1.15rem;
  font-size: 0.86rem;
  font-weight: 600;
}

.post-title { text-wrap: pretty; font-size: clamp(2.5rem, 6vw, 4.6rem); }

.title-underline {
  display: block;
  width: 9rem;
  max-width: 48%;
  margin: 0.65rem 0 1rem;
  color: var(--blue);
}

.title-underline path { stroke: currentColor; stroke-width: 3; stroke-linecap: round; }
.title-underline path + path { stroke-width: 1.6; opacity: 0.58; }

@media (prefers-reduced-motion: no-preference) {
  .title-underline path {
    stroke-dasharray: 1;
    animation: draw-underline 0.48s cubic-bezier(0.19, 0.63, 0.48, 1) both;
  }

  .title-underline path + path { animation-delay: 0.2s; }

  @keyframes draw-underline {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
}

.post-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.55rem 1rem;
  color: var(--comment);
  font-size: 0.85rem;
}

.post-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
.prose { line-height: 1.78; font-size: clamp(1rem, 0.95rem + 0.3vw, 1.12rem); }
</style>
