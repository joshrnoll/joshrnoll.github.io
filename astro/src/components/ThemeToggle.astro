<button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false">
  <svg viewBox="0 0 28 28" aria-hidden="true" class="chalk-stroke">
    <path class="moon" d="M19.4 4.2C14.5 3 9 5.9 7.2 10.5c-2.2 5.7.9 11.1 6.1 12.6 4.3 1.3 9.3-1 10.5-4.8-5 1.5-9-2.3-8.1-6.9.4-2.6 1.5-5 3.7-7.2Z" />
    <path class="sun" d="M19.5 13.9a5.3 5.3 0 1 1-10.6.5 5.3 5.3 0 1 1 10.6-.5ZM14 3.7l.1 2.5m7.3.6-1.8 1.6m4.7 5.7-2.6.2m.3 7.3-2-1.8m-5.6 4.8v-2.7m-7.8-.6 1.9-1.9m-5-5.1 2.7.1m.6-7.5 1.7 1.8" />
  </svg>
</button>

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

  const systemTheme = matchMedia('(prefers-color-scheme: dark)');
  const root = document.documentElement;
  const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : systemTheme.matches;

  function updateToggle() {
    document.querySelector('.theme-toggle')?.setAttribute('aria-pressed', String(isDark()));
  }

  document.addEventListener('click', event => {
    if (!(event.target instanceof Element) || !event.target.closest('.theme-toggle')) return;
    const theme = isDark() ? 'light' : 'dark';
    root.dataset.theme = theme;
    try {
      localStorage.setItem('board-theme', theme);
    } catch {
      // The choice still applies for the current visit.
    }
    updateToggle();
  });

  document.addEventListener('astro:before-swap', (event: TransitionBeforeSwapEvent) => {
    if (root.dataset.theme) event.newDocument.documentElement.dataset.theme = root.dataset.theme;
  });
  document.addEventListener('astro:page-load', updateToggle);
  systemTheme.addEventListener('change', updateToggle);
  window.addEventListener('storage', event => {
    if (event.key !== 'board-theme' && event.key !== null) return;
    const theme = event.newValue;
    if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
    else delete root.dataset.theme;
    updateToggle();
  });
  updateToggle();
</script>

<style>
.theme-toggle {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 2.75rem;
  height: 2.75rem;
  border: 1px solid var(--line);
  border-radius: 46% 52% 49% 44%;
  background: var(--surface);
  color: var(--blue);
  cursor: pointer;
}
.theme-toggle:hover { background: var(--selected); }
.theme-toggle svg {
  width: 1.55rem;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.2;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.sun { display: none; }
.theme-toggle[aria-pressed="true"] .sun { display: inline; }
.theme-toggle[aria-pressed="true"] .moon { display: none; }
</style>
