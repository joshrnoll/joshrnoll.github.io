---
// astro/src/components/TypingAnimation.astro
import '../styles/prose.css';

const content = {
  name: "Josh Noll",
  tagline: "You got problems? I git solutions.",
  links: [
    { label: "GitHub",   href: "https://github.com/joshrnoll",        external: true },
    { label: "LinkedIn", href: "https://linkedin.com/in/joshrnoll",   external: true },
    { label: "X",        href: "https://x.com/joshrnoll",             external: true },
  ],
};
---
<!-- Screen reader fallback -->
<p class="sr-only">Josh Noll — Girl Dad, DevOps Engineer, Homelabber. Links: GitHub, LinkedIn, X.</p>

<div
  id="hero-animation"
  data-name={content.name}
  data-tagline={content.tagline}
  data-links={JSON.stringify(content.links)}
>
  <!-- Neovim buffer frame -->
  <div class="nvim-frame" aria-hidden="true" id="nvim-frame">
    <div class="nvim-content">
      <div class="nvim-line" id="l1">
        <span class="ln">1</span><span class="lc dim"># about.md</span>
      </div>
      <div class="nvim-line" id="l2">
        <span class="ln">2</span><span class="lc"></span>
      </div>
      <div class="nvim-line" id="l3">
        <span class="ln">3</span><span class="lc" id="l3c"></span>
      </div>
      <div class="nvim-line" id="l4">
        <span class="ln">4</span><span class="lc"></span>
      </div>
      <div class="nvim-line" id="l5">
        <span class="ln">5</span><span class="lc" id="l5c"></span>
      </div>
      <div class="nvim-line" id="l6">
        <span class="ln">6</span><span class="lc"></span>
      </div>
      <div class="nvim-line" id="l7">
        <span class="ln">7</span><span class="lc" id="l7c"></span>
      </div>
    </div>
  </div>

  <!-- Markdown preview — rendered from same content object, shown after animation -->
  <div class="md-preview prose" id="md-preview" aria-hidden="true">
    <h2>{content.name}</h2>
    <p>{content.tagline}</p>
    <p class="md-links">
      {content.links.map((link, i) => (
        <>
          {i > 0 && <Fragment>&nbsp;&nbsp;</Fragment>}
          <a href={link.href} {...(link.external ? { target: "_blank", rel: "noopener" } : {})}>
            [{link.label}]
          </a>
        </>
      ))}
    </p>
  </div>
</div>

<script>
  import { INTRO_BEATS, INTRO_TYPING } from '../../../resume/src/intro-typing.js';

  const sleep = (ms: number) => new Promise<void>(r => setTimeout(r, ms));

  async function typeText(el: HTMLElement, text: string, speed: number) {
    for (const ch of text) {
      el.textContent = (el.textContent ?? '') + ch;
      await sleep(speed + Math.random() * INTRO_TYPING.jitterMs);
    }
  }

  async function showKeys(_keys: string, duration = 700) {
    await sleep(duration);
  }

  function setActive(lineId: string) {
    document.querySelectorAll('.nvim-line.active').forEach(e => e.classList.remove('active'));
    document.getElementById(lineId)?.classList.add('active');
  }

  async function runAnimation() {
    const container = document.getElementById('hero-animation')!;
    const animName    = container.dataset.name!;
    const animTagline = container.dataset.tagline!;
    const animLinks: Array<{ label: string; href: string; external?: boolean }>
      = JSON.parse(container.dataset.links!);

    await sleep(INTRO_BEATS.startMs);

    // gg — go to top
    setActive('l1');
    await showKeys('gg', INTRO_BEATS.keyMs);
    await sleep(INTRO_BEATS.afterGgMs);

    // G — go to bottom
    await showKeys('G', INTRO_BEATS.keyMs);
    setActive('l7');
    await sleep(INTRO_BEATS.afterGMs);

    // ciw — change the heading, same beat as the resume's heading line
    setActive('l3');
    await sleep(INTRO_BEATS.beforeTypeMs);
    await showKeys('ciw', INTRO_BEATS.ciwMs);
    const l3c = document.getElementById('l3c')!;
    l3c.textContent = '## ';
    await typeText(l3c, animName, INTRO_TYPING.headingMs);
    await sleep(INTRO_BEATS.afterTypeMs);

    // tagline
    setActive('l5');
    await sleep(INTRO_BEATS.beforeTypeMs);
    await showKeys('i', INTRO_BEATS.insertMs);
    const l5c = document.getElementById('l5c')!;
    await typeText(l5c, animTagline, INTRO_TYPING.bodyMs);
    await sleep(INTRO_BEATS.afterTypeMs);

    // links
    setActive('l7');
    await sleep(INTRO_BEATS.beforeTypeMs);
    await showKeys('i', INTRO_BEATS.insertMs);
    const l7c = document.getElementById('l7c')!;
    const linkText = animLinks.map(l => `[${l.label}]`).join('  ');
    await typeText(l7c, linkText, INTRO_TYPING.bodyMs);
    await sleep(INTRO_BEATS.afterTypeMs);

    // Esc — final state, then the same return-to-top and reveal as the resume
    setActive('l1');

    // Replace link text with actual anchor tags
    l7c.innerHTML = animLinks
      .map(l => {
        const attrs = l.external ? ' target="_blank" rel="noopener"' : '';
        return `<a href="${l.href}"${attrs}>[${l.label}]</a>`;
      })
      .join('  ');

    await showKeys('gg', INTRO_BEATS.keyMs);
    await sleep(INTRO_BEATS.afterEndGgMs);
    await sleep(INTRO_BEATS.previewMs);

    // Fade out editor, fade in preview
    const frame   = document.getElementById('nvim-frame')!;
    const preview = document.getElementById('md-preview')!;
    frame.classList.add('fading-out');
    await sleep(INTRO_BEATS.fadeMs);
    frame.style.display = 'none';
    preview.classList.add('visible');
    preview.removeAttribute('aria-hidden');
  }

  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('hero-animation')) return;
    runAnimation();
  });
</script>

<style>
.nvim-frame {
  background: var(--bg-dark);
  border: 1px solid var(--comment);
  border-radius: 6px;
  overflow: hidden;
  max-width: 580px;
  font-family: var(--font-mono);
  font-size: 0.95rem;
  transition: opacity 0.25s ease;
}
.nvim-frame.fading-out { opacity: 0; }

.nvim-content { padding: 0.5rem 0; }
.nvim-line {
  display: flex;
  padding: 0 0.75rem;
  line-height: 1.7;
  position: relative;
}
.nvim-line.active { background: color-mix(in srgb, var(--blue) 8%, transparent); }
.nvim-line.active .lc::after {
  content: '█';
  color: var(--blue);
  animation: blink 1s step-end infinite;
}
.ln {
  color: var(--comment);
  min-width: 1.75em;
  text-align: right;
  margin-right: 1.25em;
  user-select: none;
  flex-shrink: 0;
}
.lc { color: var(--fg); flex: 1; min-height: 1.7em; }
.lc.dim { color: var(--comment); }
.lc a { color: var(--blue); }
.lc a:hover { color: var(--cyan); }

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* Markdown preview */
.md-preview {
  max-width: 580px;
  display: none;
  opacity: 0;
  transition: opacity 0.5s ease;
}
.md-preview.visible {
  display: block;
  opacity: 1;
}
</style>
