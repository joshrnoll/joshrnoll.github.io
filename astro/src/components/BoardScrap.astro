---
import type { CollectionEntry } from 'astro:content';

type Scrap = CollectionEntry<'scraps'>['data']['wall'][number];

interface Props {
  scrap: Scrap;
  target?: { id: string; title: string };
  delay?: number;
}
const { scrap, target, delay = 100 } = Astro.props;
const Element = target ? 'a' : 'div';
// Skip the client router so fragment navigation moves focus and emits hashchange.
const link = target && {
  href: `#${target.id}`,
  'data-thread': target.id,
  'data-astro-reload': true,
  'aria-label': `${scrap.text} Follow the arrow to ${target.title}`,
};
const lines = scrap.text.split('\n');
let wordIndex = 0;
---
<Element
  class:list={['scrap', `paper-${scrap.paper}`, `ink-${scrap.ink ?? 'black'}`]}
  {...link}
  style={`--ink-delay: ${delay}ms`}
>
  <span class="scrap-text">
    {lines.map(line => (
      <span class="scrap-line">
        {line.split(/\s+/).map((word, index) => (
          <>{index > 0 && ' '}<span class="ink-word" style={`--word-delay: ${wordIndex++ * 48}ms`}>{word}</span></>
        ))}
      </span>
    ))}
  </span>
  {target && (
    <svg class="scrap-mark ring chalk-stroke" viewBox="0 0 240 112" preserveAspectRatio="none" aria-hidden="true">
      <path d="M164 12C122 1 63 6 30 21 9 30 0 44 9 65c10 25 53 39 105 40 57 1 115-16 120-48 4-21-19-38-46-46-17-5-24-5-35-5" />
      <path class="dry-ink" d="M149 9C78 2 20 20 12 44 2 78 60 103 126 102c49-1 100-20 105-44 6-24-24-39-73-47" />
    </svg>
  )}
  {scrap.crossedOut && (
    <svg class="scrap-mark strike chalk-stroke" viewBox="0 0 240 112" preserveAspectRatio="none" aria-hidden="true">
      <path d="M17 61Q77 58 123 49T221 39" />
      <path class="dry-ink" d="M29 69Q81 65 141 53T228 41" />
    </svg>
  )}
</Element>

<script>
  // Measure each mark's on-screen length. A stretched path with a non-scaling stroke
  // is longer on screen than in its viewBox, so a pathLength="1" dash only drew part
  // of the ring on tall notes.
  function measureMarks() {
    for (const path of document.querySelectorAll<SVGPathElement>('.scrap-mark path')) {
      const ctm = path.getScreenCTM();
      if (!ctm) continue;
      const total = path.getTotalLength();
      let length = 0;
      let previous: DOMPoint | undefined;
      for (let step = 0; step <= 96; step++) {
        const point = path.getPointAtLength((total * step) / 96).matrixTransform(ctm);
        if (previous) length += Math.hypot(point.x - previous.x, point.y - previous.y);
        previous = point;
      }
      path.style.setProperty('--mark-length', `${Math.ceil(Math.max(length, total)) + 4}px`);
    }
  }

  let resize: ResizeObserver | undefined;
  document.addEventListener('astro:page-load', () => {
    measureMarks();
    resize?.disconnect();
    resize = new ResizeObserver(measureMarks);
    document.querySelectorAll('.scrap-mark').forEach(mark => resize?.observe(mark));
  });
</script>

<style>
.scrap {
  --ink: var(--fg);
  --tilt: 0deg;
  display: grid;
  place-content: center;
  position: relative;
  isolation: isolate;
  min-height: 7rem;
  padding: 1.2rem 1.35rem;
  text-align: center;
  color: var(--ink);
  font: 700 clamp(1.12rem, 1.8vw, 1.52rem)/1.19 var(--font-marker);
  transform: rotate(var(--tilt));
  transition: transform 180ms ease;
}
.scrap:hover, .scrap:focus-visible { color: var(--ink); text-decoration: none; }
/* Circled scraps keep their text inside the hand-drawn ellipse. */
.scrap[data-thread] {
  padding: 3.2rem 2.2rem;
  font-size: clamp(1.1rem, 1.7vw, 1.44rem);
}
.scrap:not(.paper-ink)::before, .scrap:not(.paper-ink)::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
}
.scrap:not(.paper-ink)::before {
  inset: 3px 4px 0;
  background: #41382a;
  filter: blur(7px);
  opacity: .22;
  transform: translateY(5px) rotate(1.5deg);
}
.scrap:not(.paper-ink)::after {
  clip-path: polygon(1% 2%, 37% 1%, 71% 1.7%, 99.6% 0, 98.8% 30%, 100% 67%, 99.5% 96%, 62% 99%, 26% 98%, 0 99%, .6% 52%);
  background: var(--paper);
}
.paper-yellow { --paper: linear-gradient(165deg, light-dark(#f7df80, #d2bb72), light-dark(#fff1aa, #ecdaa0) 60%); }
.paper-pink { --paper: linear-gradient(168deg, light-dark(#f2b9c4, #d09fae), light-dark(#ffd1d9, #e0b8c2) 62%); }
.paper-blue { --paper: linear-gradient(166deg, light-dark(#a9cedf, #97b4c2), light-dark(#c9e6ee, #b8d1d8) 54%); }
.paper-ruled {
  --paper: linear-gradient(90deg, transparent 13%, #db84876b 13.3%, transparent 14%),
    repeating-linear-gradient(transparent 0 21px, #7c9ec355 21px 22px),
    linear-gradient(152deg, light-dark(#f3e9bd, #cfc6a0), light-dark(#fffbdf, #ebe2c3));
}
.ink-blue { --ink: var(--blue); }
.ink-red { --ink: var(--red); }
.ink-green { --ink: var(--green); }
.scrap:not(.paper-ink) { --ink: #202a28; }
.scrap:not(.paper-ink).ink-blue { --ink: #2058a6; }
.scrap:not(.paper-ink).ink-red { --ink: #7e2733; }
.scrap:not(.paper-ink).ink-green { --ink: #205745; }
.scrap-line { display: block; }
.scrap-line + .scrap-line { margin-top: .3em; }
.ink-word { display: inline-block; }
.scrap-mark {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.4;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.scrap-mark path { vector-effect: non-scaling-stroke; }
/* The ring circles the whole note, so it sits just outside the paper, the way a
   marker circle would on a whiteboard. That leaves the text room inside it. */
.scrap-mark.ring {
  inset: auto;
  top: -1.3rem;
  left: -1.2rem;
  width: calc(100% + 2.4rem);
  height: calc(100% + 2.6rem);
  overflow: visible;
}
.dry-ink { opacity: .4; stroke-width: 1.25; }
@media (prefers-reduced-motion: no-preference) {
  .scrap[data-thread]:hover, .scrap[data-thread]:focus-visible,
  .scrap:not(.paper-ink):hover { transform: translateY(-5px) rotate(calc(var(--tilt) * .45)); z-index: 1; }
  .ink-word {
    animation: write-word 220ms ease-out backwards;
    animation-delay: calc(var(--ink-delay) + var(--word-delay));
  }
  /* The marks stretch to fit each note but keep an even stroke width, so their
     on-screen length varies by note shape. The script below measures it into
     --mark-length; until it does, marks show fully drawn. */
  .scrap-mark path[style*="--mark-length"] {
    stroke-dasharray: var(--mark-length);
    animation: draw-mark 660ms ease-out backwards;
    animation-delay: calc(var(--ink-delay) + 430ms);
  }
  .scrap-mark .dry-ink { animation-delay: calc(var(--ink-delay) + 570ms); }
}
@keyframes write-word {
  from { clip-path: inset(-.2em 100% -.2em 0); }
  to { clip-path: inset(-.2em 0 -.2em 0); }
}
@keyframes draw-mark { from { stroke-dashoffset: var(--mark-length); } }
@media (prefers-reduced-motion: reduce) {
  .scrap { transition: none; }
}
</style>
