---
// astro/src/components/TagFilter.astro
interface Props { tags: string[]; }
const { tags } = Astro.props;
---
<div class="tag-filter" id="tag-filter">
  <span class="filter-label">// filter</span>
  <div class="tag-pills" id="tag-pills">
    {tags.map(tag => (
      <button class="tag-pill" data-tag={tag.toLowerCase()} type="button">
        [{tag}]
      </button>
    ))}
  </div>
  <button class="clear-btn" id="clear-tags" type="button" hidden>clear</button>
</div>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.tag-pill');
  const clearBtn = document.getElementById('clear-tags') as HTMLButtonElement;
  const cards = document.querySelectorAll<HTMLElement>('.blog-card');
  let activeTags = new Set<string>();

  function applyFilter() {
    // OR logic: show card if it has ANY active tag (or no filter active)
    cards.forEach(card => {
      if (activeTags.size === 0) {
        card.hidden = false;
        return;
      }
      const cardTags = (card.dataset.tags || '').split(',').filter(Boolean);
      card.hidden = !cardTags.some(t => activeTags.has(t));
    });

    clearBtn.hidden = activeTags.size === 0;

    document.dispatchEvent(new CustomEvent('tag-filter-changed', { detail: { activeTags: [...activeTags] } }));
  }

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      const tag = pill.dataset.tag!;
      if (activeTags.has(tag)) {
        activeTags.delete(tag);
        pill.classList.remove('active');
      } else {
        activeTags.add(tag);
        pill.classList.add('active');
      }
      applyFilter();
    });
  });

  clearBtn.addEventListener('click', () => {
    activeTags.clear();
    pills.forEach(p => p.classList.remove('active'));
    applyFilter();
  });

  // Expose activeTags for SearchBar composition
  (window as any).__activeTags = activeTags;
</script>

<style>
.tag-filter {
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}
.filter-label { color: var(--comment); font-size: 0.8rem; flex-shrink: 0; }
.tag-pills { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.tag-pill {
  background: transparent;
  border: 1px solid var(--comment);
  color: var(--comment);
  font-family: var(--font-mono);
  font-size: 0.8rem;
  padding: 0.15em 0.4em;
  border-radius: 2px;
  cursor: pointer;
  transition: all 0.15s;
}
.tag-pill:hover { border-color: var(--blue); color: var(--blue); }
.tag-pill.active { border-color: var(--blue); color: var(--blue); background: color-mix(in srgb, var(--blue) 15%, transparent); }
.clear-btn {
  background: transparent;
  border: none;
  color: var(--red);
  font-family: var(--font-mono);
  font-size: 0.8rem;
  cursor: pointer;
  padding: 0.15em 0.4em;
}
.clear-btn:hover { text-decoration: underline; }
</style>
