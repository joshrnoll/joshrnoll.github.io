---
interface Props { tags: string[]; }
const { tags } = Astro.props;
---
<div class="tag-filter">
  <button class="filter-trigger" type="button" aria-haspopup="dialog" aria-controls="tag-panel">
    <svg class="filter-ink chalk-stroke" viewBox="0 0 168 46" preserveAspectRatio="none" aria-hidden="true">
      <path d="M6 6Q74 1 161 5l2 35Q91 44 6 41L5 5M9 4l150 3M8 42q73-2 148-1" />
    </svg>
    Filter by tag
    <span class="filter-count" hidden></span>
  </button>
  <dialog class="tag-panel" id="tag-panel" aria-labelledby="filter-label">
    <header class="panel-heading">
      <h2 id="filter-label">Filter by tag</h2>
      <button class="close-panel" type="button" aria-label="Close tag filter" autofocus>×</button>
    </header>
    <div class="tag-pills" role="group" aria-labelledby="filter-label">
      {tags.map(tag => (
        <button class="tag-pill" data-tag={tag.toLowerCase()} type="button" aria-pressed="false">
          {tag}
        </button>
      ))}
    </div>
    <footer class="panel-actions">
      <button class="clear-btn" type="button" disabled>Clear tags</button>
      <button class="done-btn" type="button">Done</button>
    </footer>
  </dialog>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const panel = document.querySelector<HTMLDialogElement>('.tag-panel');
    const trigger = document.querySelector<HTMLButtonElement>('.filter-trigger');
    const count = trigger?.querySelector<HTMLElement>('.filter-count');
    const clearButton = panel?.querySelector<HTMLButtonElement>('.clear-btn');
    if (!panel || !trigger || !count || !clearButton) return;

    trigger.addEventListener('click', () => panel.showModal());
    panel.querySelectorAll('.close-panel, .done-btn').forEach(button => {
      button.addEventListener('click', () => panel.close());
    });
    panel.addEventListener('close', () => trigger.focus());

    const pills = panel.querySelectorAll<HTMLButtonElement>('.tag-pill');
    const cards = document.querySelectorAll<HTMLElement>('#post-list .blog-card');

    const applyFilter = () => {
      const activeTags = Array.from(pills)
        .filter(pill => pill.getAttribute('aria-pressed') === 'true')
        .map(pill => pill.dataset.tag);
      cards.forEach(card => {
        const tags = card.dataset.tags?.split(',') ?? [];
        card.hidden = activeTags.length > 0 && !tags.some(tag => activeTags.includes(tag));
      });
      const selected = activeTags.length;
      clearButton.disabled = selected === 0;
      count.hidden = selected === 0;
      count.textContent = selected ? String(selected) : '';
      trigger.setAttribute('aria-label', selected ? `Filter by tag, ${selected} selected` : 'Filter by tag');
    };

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pill.setAttribute('aria-pressed', String(pill.getAttribute('aria-pressed') !== 'true'));
        applyFilter();
      });
    });

    clearButton.addEventListener('click', () => {
      pills.forEach(pill => pill.setAttribute('aria-pressed', 'false'));
      applyFilter();
      pills[0]?.focus();
    });
  });
</script>

<style>
.tag-filter { margin-bottom: 1.7rem; }
.filter-trigger {
  position: relative;
  isolation: isolate;
  min-height: 2.75rem;
  padding: .35rem 1rem;
  border: 0;
  background: transparent;
  color: var(--blue);
  font: 700 1.14rem/1.2 var(--font-marker);
  cursor: pointer;
}
.filter-trigger:hover { background: var(--selected); }
.filter-ink {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linejoin: round;
  pointer-events: none;
}
.filter-count { margin-left: .2em; font-size: .85em; }
.tag-panel {
  position: fixed;
  inset: 0;
  margin: auto;
  width: min(40rem, calc(100% - 2rem));
  max-height: min(75dvh, 40rem);
  padding: 0;
  border: 1px solid var(--line);
  border-radius: .7rem .45rem .65rem .4rem;
  background: var(--bg-popup);
  color: var(--fg);
  box-shadow: 0 1rem 3rem #131c1a55;
  overflow: hidden;
}
.tag-panel[open] { display: flex; flex-direction: column; }
.tag-panel::backdrop { background: #131c1a65; }
.panel-heading, .panel-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .75rem;
  padding: .75rem 1.15rem;
}
.panel-heading { border-bottom: 1px solid var(--line); }
.panel-heading h2 { color: var(--blue); font: 700 1.55rem/1.2 var(--font-marker); }
.close-panel, .done-btn {
  min-height: 2.75rem;
  padding: .25rem .7rem;
  border: 1px solid var(--line);
  border-radius: .4rem;
  background: var(--surface);
  color: var(--fg);
  cursor: pointer;
}
.close-panel { min-width: 2.75rem; font-size: 1.4rem; }
.close-panel:hover, .done-btn:hover { background: var(--selected); }
.tag-pills {
  display: flex;
  flex-wrap: wrap;
  gap: .45rem;
  padding: .85rem 1.15rem;
  overflow-y: auto;
  overscroll-behavior: contain;
}
.panel-actions { border-top: 1px solid var(--line); }
@media (max-width: 540px) {
  .tag-panel {
    inset: auto 0 0;
    margin: 0;
    width: 100%;
    max-width: none;
    max-height: 80dvh;
    border-radius: .8rem .8rem 0 0;
  }
  .panel-actions { padding-bottom: max(.75rem, env(safe-area-inset-bottom)); }
}

.tag-pill {
  min-height: 2rem;
  padding: 0.25rem 0.65rem;
  border: 1px solid var(--line);
  border-radius: 100px;
  background: var(--surface);
  color: var(--fg);
  font-size: 0.77rem;
  line-height: 1.5;
  cursor: pointer;
}

.tag-pill:hover,
.tag-pill[aria-pressed="true"] { border-color: var(--blue); color: var(--blue); }
.tag-pill[aria-pressed="true"] { background: var(--selected); }

.clear-btn {
  justify-self: start;
  min-height: 2.75rem;
  padding: 0.4rem;
  border: 0;
  background: transparent;
  color: var(--blue);
  font-size: 0.81rem;
  cursor: pointer;
}

.clear-btn:hover:enabled { text-decoration: underline; }
.clear-btn:disabled { color: var(--comment); cursor: default; }
</style>
