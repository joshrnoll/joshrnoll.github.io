---
interface Props { tags: string[]; }
const { tags } = Astro.props;
---
<div class="tag-filter" id="tag-filter">
  <span id="filter-label" class="filter-label">Filter by tag</span>
  <div class="tag-pills" role="group" aria-labelledby="filter-label">
    {tags.map(tag => (
      <button class="tag-pill" data-tag={tag.toLowerCase()} type="button" aria-pressed="false">
        {tag}
      </button>
    ))}
  </div>
  <button class="clear-btn" id="clear-tags" type="button" hidden>Clear tags</button>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const clearButton = document.querySelector<HTMLButtonElement>('#clear-tags');
    if (!clearButton) return;

    const pills = document.querySelectorAll<HTMLButtonElement>('.tag-pill');
    const cards = document.querySelectorAll<HTMLElement>('#post-list .blog-card');

    const applyFilter = () => {
      const activeTags = Array.from(pills)
        .filter(pill => pill.getAttribute('aria-pressed') === 'true')
        .map(pill => pill.dataset.tag);
      cards.forEach(card => {
        const tags = card.dataset.tags?.split(',') ?? [];
        card.hidden = activeTags.length > 0 && !tags.some(tag => activeTags.includes(tag));
      });
      clearButton.hidden = activeTags.length === 0;
    };

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pill.setAttribute('aria-pressed', String(pill.getAttribute('aria-pressed') !== 'true'));
        applyFilter();
      });
    });

    clearButton.addEventListener('click', () => {
      pills.forEach(pill => pill.setAttribute('aria-pressed', 'false'));
      applyFilter();
    });
  });
</script>

<style>
.tag-filter { margin-bottom: 1.7rem; display: grid; gap: 0.5rem; }
.filter-label { color: var(--comment); font-size: 0.82rem; font-weight: 600; }
.tag-pills { display: flex; gap: 0.38rem; flex-wrap: wrap; }

.tag-pill {
  padding: 0.25rem 0.65rem;
  border: 1px solid var(--line);
  border-radius: 100px;
  background: var(--surface);
  color: var(--fg);
  font-size: 0.77rem;
  line-height: 1.5;
  cursor: pointer;
}

.tag-pill:hover,
.tag-pill[aria-pressed="true"] { border-color: var(--blue); color: var(--blue); }
.tag-pill[aria-pressed="true"] { background: #e6eefb; }

.clear-btn {
  justify-self: start;
  padding: 0.2rem;
  border: 0;
  background: transparent;
  color: var(--blue);
  font-size: 0.81rem;
  cursor: pointer;
}

.clear-btn:hover { text-decoration: underline; }
</style>
