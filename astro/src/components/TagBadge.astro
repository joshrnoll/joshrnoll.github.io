---
interface Props {
  tag: string;
  href?: string;
  active?: boolean;
}
const { tag, href, active = false } = Astro.props;
---
{href ? (
  <a href={href} class:list={['tag-badge', { active }]}>{tag}</a>
) : (
  <span class:list={['tag-badge', { active }]}>{tag}</span>
)}

<style>
.tag-badge {
  display: inline-block;
  padding: 0.16rem 0.55rem;
  border-radius: 100px;
  background: var(--bg-dark);
  color: var(--comment);
  font-size: 0.76rem;
  line-height: 1.5;
}

a.tag-badge:hover, .tag-badge.active {
  color: var(--blue);
  text-decoration: none;
}
</style>
