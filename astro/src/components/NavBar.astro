---
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || (path !== '/' && currentPath.startsWith(path));
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/notes/', label: 'Notes' },
  { href: '/projects/', label: 'Projects' },
  { href: '/homelab/', label: 'Homelab' },
  { href: '/scrapyard/', label: 'Scrapyard' },
  { href: '/resume/', label: 'Resume' },
];
---
<nav class="site-nav" aria-label="Primary navigation">
  <div class="container nav-inner">
    <a href="/" class="site-brand">Josh Noll<span aria-hidden="true">.</span></a>
    <ul class="nav-links">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class="nav-link"
            aria-current={isActive(link.href) ? 'page' : undefined}
            data-astro-reload={link.href === '/resume/' ? true : undefined}
          >
            {link.label}
            <svg aria-hidden="true" viewBox="0 0 72 8" preserveAspectRatio="none" fill="none">
              <path d="M2 6 C14 2.8 32 3.7 46 2.5 Q61 1.4 70 2.8 M12 6.5 Q38 4.4 57 4.7" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
.site-nav {
  position: sticky;
  top: 0;
  z-index: 20;
  border-bottom: 1px solid var(--line);
  --nav-ink: #202a28;
  --nav-muted: #53615d;
  --nav-accent: #2058a6;
  background: #f8f9f5f5;
  backdrop-filter: blur(8px);
  font-family: var(--font-body);
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-height: 4.35rem;
}

.site-brand {
  flex: 0 0 auto;
  color: var(--nav-ink);
  font-size: 1.22rem;
  font-weight: 800;
  letter-spacing: -0.055em;
}

.site-brand span { color: var(--nav-accent); }
.site-brand:hover { color: var(--nav-accent); text-decoration: none; }

.nav-links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0 clamp(0.7rem, 2.1vw, 1.65rem);
  list-style: none;
}

.nav-link {
  position: relative;
  display: grid;
  align-items: center;
  min-height: 2.4rem;
  color: var(--nav-muted);
  font-size: 0.85rem;
  font-weight: 600;
}

.nav-link:hover,
.nav-link[aria-current] {
  color: var(--nav-accent);
  text-decoration: none;
}

.nav-link svg {
  position: absolute;
  inset: auto -0.12em 0.21rem;
  width: calc(100% + 0.24em);
  height: 0.36rem;
  stroke: currentColor;
  stroke-width: 1.65;
  stroke-linecap: round;
  visibility: hidden;
  pointer-events: none;
}

.nav-link[aria-current] svg { visibility: visible; }

@media (max-width: 720px) {
  .nav-inner { flex-direction: column; align-items: flex-start; gap: 0; padding-block: 0.55rem; }
  .nav-links { gap: 0 0.55rem; }
  .nav-link { min-height: 2rem; font-size: 0.775rem; }
}
</style>
