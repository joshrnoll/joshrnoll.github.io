---
// astro/src/components/NavBar.astro
const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
  currentPath === path || currentPath.startsWith(path + '/');

const links = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/notes/', label: 'Notes' },
  { href: '/projects/', label: 'Projects' },
  { href: '/resume/', label: 'Resume' },
  { href: '/homelab/', label: 'Homelab' },
];
---
<nav class="navbar" aria-label="Primary navigation">
  <div class="container navbar-inner">
    <a href="/" class="brand">Josh Noll</a>
    <ul class="nav-links">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: !link.external && isActive(link.href) }]}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
.navbar {
  background: var(--bg-dark);
  border-bottom: 1px solid var(--comment);
  position: sticky;
  top: 0;
  z-index: 100;
}
.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 0.75rem;
  padding-bottom: 0.75rem;
}
.brand {
  color: var(--green);
  font-weight: 700;
  font-size: 1rem;
}
.brand:hover { color: var(--cyan); text-decoration: none; }
.nav-links {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  list-style: none;
}
.nav-link { color: var(--comment); font-size: 0.9rem; }
.nav-link:hover { color: var(--fg); text-decoration: none; }
.nav-link.active { color: var(--cyan); }

@media (max-width: 600px) {
  .nav-links { gap: 1rem; }
  .brand { display: none; }
}
</style>
