# light palette: whiteboard board, marker ink, and sticky notes.
style.fill: "#fbfcf8"
classes: {
  zone-network: {style: {fill: "#ffffff"; stroke: "#202a28"; font-color: "#202a28"; stroke-width: 2; border-radius: 6; font-size: 22; bold: true}}
  zone-talos: {style: {fill: "#ffffff"; stroke: "#23634c"; font-color: "#23634c"; stroke-width: 3; border-radius: 6; font-size: 22; bold: true}}
  zone-proxmox: {style: {fill: "#ffffff"; stroke: "#ad3e45"; font-color: "#ad3e45"; stroke-width: 3; border-radius: 6; font-size: 22; bold: true}}
  zone-storage: {style: {fill: "#ffffff"; stroke: "#2058a6"; font-color: "#2058a6"; stroke-width: 3; border-radius: 6; font-size: 22; bold: true}}
  zone-standalone: {style: {fill: "#ffffff"; stroke: "#202a28"; font-color: "#202a28"; stroke-width: 2; border-radius: 6; font-size: 22; bold: true}}
  zone-cold: {style: {fill: "#ffffff"; stroke: "#53615d"; font-color: "#53615d"; stroke-width: 2; stroke-dash: 6; border-radius: 6; font-size: 20; bold: true}}
  host: {style: {fill: "#f7f8f3"; stroke: "#202a28"; font-color: "#202a28"; stroke-width: 2; font-size: 18; bold: true}}
  sticky-yellow: {style: {fill: "#fff1a6"; stroke: "#202a28"; font-color: "#202a28"; stroke-width: 2; font-size: 17; shadow: true}}
  sticky-pink: {style: {fill: "#ffd3df"; stroke: "#202a28"; font-color: "#202a28"; stroke-width: 2; font-size: 17; shadow: true}}
  sticky-blue: {style: {fill: "#d4e9ff"; stroke: "#202a28"; font-color: "#202a28"; stroke-width: 2; font-size: 17; shadow: true}}
  sticky-green: {style: {fill: "#d8f0d3"; stroke: "#202a28"; font-color: "#202a28"; stroke-width: 2; font-size: 17; shadow: true}}
  sticky-plain: {style: {fill: "#eef0ea"; stroke: "#202a28"; font-color: "#202a28"; stroke-width: 2; font-size: 17; shadow: true}}
  strong: {style: {bold: true; stroke-width: 3}}
  ink: {style: {stroke: "#202a28"; font-color: "#202a28"; stroke-width: 2; font-size: 17}}
  blue: {style: {stroke: "#2058a6"; font-color: "#2058a6"; stroke-width: 3; font-size: 17}}
  red: {style: {stroke: "#ad3e45"; font-color: "#ad3e45"; stroke-width: 3; font-size: 17}}
  dashed: {style: {stroke-dash: 5}}
}
