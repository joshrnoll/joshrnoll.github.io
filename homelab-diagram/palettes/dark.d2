# dark palette: chalkboard board, marker ink, and sticky notes.
style.fill: "#1a2422"
classes: {
  zone-network: {style: {fill: "#22302d"; stroke: "#f1f0e5"; font-color: "#f1f0e5"; stroke-width: 2; border-radius: 6; font-size: 22; bold: true}}
  zone-talos: {style: {fill: "#22302d"; stroke: "#e8db9f"; font-color: "#e8db9f"; stroke-width: 3; border-radius: 6; font-size: 22; bold: true}}
  zone-proxmox: {style: {fill: "#22302d"; stroke: "#f3b0bc"; font-color: "#f3b0bc"; stroke-width: 3; border-radius: 6; font-size: 22; bold: true}}
  zone-storage: {style: {fill: "#22302d"; stroke: "#a8cff5"; font-color: "#a8cff5"; stroke-width: 3; border-radius: 6; font-size: 22; bold: true}}
  zone-standalone: {style: {fill: "#22302d"; stroke: "#f1f0e5"; font-color: "#f1f0e5"; stroke-width: 2; border-radius: 6; font-size: 22; bold: true}}
  zone-cold: {style: {fill: "#22302d"; stroke: "#bcc9c1"; font-color: "#bcc9c1"; stroke-width: 2; stroke-dash: 6; border-radius: 6; font-size: 20; bold: true}}
  host: {style: {fill: "#2b3b37"; stroke: "#f1f0e5"; font-color: "#f1f0e5"; stroke-width: 2; font-size: 18; bold: true}}
  sticky-yellow: {style: {fill: "#e8d98f"; stroke: "#1c2321"; font-color: "#1c2321"; stroke-width: 2; font-size: 17; shadow: true}}
  sticky-pink: {style: {fill: "#e9b9c6"; stroke: "#1c2321"; font-color: "#1c2321"; stroke-width: 2; font-size: 17; shadow: true}}
  sticky-blue: {style: {fill: "#b5d2ec"; stroke: "#1c2321"; font-color: "#1c2321"; stroke-width: 2; font-size: 17; shadow: true}}
  sticky-green: {style: {fill: "#bcdcb2"; stroke: "#1c2321"; font-color: "#1c2321"; stroke-width: 2; font-size: 17; shadow: true}}
  sticky-plain: {style: {fill: "#cfd3c9"; stroke: "#1c2321"; font-color: "#1c2321"; stroke-width: 2; font-size: 17; shadow: true}}
  strong: {style: {bold: true; stroke-width: 3}}
  ink: {style: {stroke: "#f1f0e5"; font-color: "#f1f0e5"; stroke-width: 2; font-size: 17}}
  blue: {style: {stroke: "#a8cff5"; font-color: "#a8cff5"; stroke-width: 3; font-size: 17}}
  red: {style: {stroke: "#f3b0bc"; font-color: "#f3b0bc"; stroke-width: 3; font-size: 17}}
  dashed: {style: {stroke-dash: 5}}
}
